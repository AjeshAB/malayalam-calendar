# Server
PORT=3002

# Optional Gemini rewrite for daily rashiphalam.
# Without a key, template prose is used.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or use the horoscope-specific name (either works):
# HOROSCOPE_LLM_API_KEY=

# Optional overrides (defaults shown)
# HOROSCOPE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# HOROSCOPE_LLM_MODEL=gemini-flash-latest
